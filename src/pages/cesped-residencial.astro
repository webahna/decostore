---
import Layout from "../layouts/Layout.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import {
  faArrowLeft,
  faArrowRight,
  faBroom,
  faCheck,
  faChildReaching,
  faCubes,
  faDropletSlash,
  faEye,
  faFaceSmile,
  faGem,
  faHouse,
  faLayerGroup,
  faMugHot,
  faPaw,
  faPersonFalling,
  faRotate,
  faShieldDog,
  faShieldHalved,
  faShoePrints,
  faSoap,
  faTemperatureLow,
} from "@fortawesome/free-solid-svg-icons";

const quoteUrl =
  "https://wa.me/5212219690933?text=Hola%2C%20me%20gustar%C3%ADa%20cotizar%20una%20instalaci%C3%B3n%20de%20c%C3%A9sped%20sint%C3%A9tico%20residencial.";

const sharedBenefits = [
  { icon: faBroom, title: "Mínimo mantenimiento", description: "No necesita cortar, regar ni fertilizar." },
  { icon: faDropletSlash, title: "Ahorro de agua", description: "No necesita riego, cuidando tu bolsillo y el ambiente." },
  { icon: faShieldHalved, title: "Alta resistencia", description: "Soporta el uso diario, juegos y clima sin desgastarse." },
  { icon: faChildReaching, title: "Seguro y confortable", description: "Una superficie suave para convivir y jugar." },
  { icon: faShoePrints, title: "Alto tránsito", description: "Mantiene su forma y estética donde hay mucho paso." },
  { icon: faHouse, title: "Mejora cualquier espacio", description: "Embellece patios, balcones, jardines y terrazas." },
  { icon: faFaceSmile, title: "Hipoalergénico", description: "Ideal para personas sensibles al polen o al pasto natural." },
  { icon: faSoap, title: "Fácil de limpiar", description: "Para el cuidado cotidiano solo necesitas barrer o enjuagar." },
  { icon: faPaw, title: "Pet-friendly", description: "Cómodo y resistente para tus mascotas." },
];

const premiumBenefits = [
  { icon: faEye, title: "Apariencia natural", description: "Luce y se siente como pasto real recién cortado." },
  { icon: faCubes, title: "Mayor densidad", description: "Su fibra más densa ofrece una sensación más abundante." },
  { icon: faRotate, title: "Excelente recuperación", description: "Recupera su forma después de ser pisado." },
  { icon: faShieldDog, title: "Para niños y mascotas", description: "Superficie amortiguada para las actividades cotidianas." },
  { icon: faGem, title: "Acabado de alta gama", description: "Añade un aspecto elegante y cuidado al espacio." },
  { icon: faPersonFalling, title: "Mayor amortiguación", description: "Aporta una pisada más cómoda para zonas de juego." },
  { icon: faLayerGroup, title: "Menos relleno", description: "Su densidad reduce la necesidad de material de relleno." },
  { icon: faTemperatureLow, title: "Aislamiento adicional", description: "Ayuda a reducir la transmisión de calor y ruido." },
  { icon: faMugHot, title: "Ideal para descansar", description: "Perfecto para relajarse, leer o disfrutar del exterior." },
];

const gallery = [
  { url: "/cesped-residencial/uno.webp", alt: "Instalación de pasto sintético en jardín residencial moderno" },
  { url: "/cesped-residencial/dos.webp", alt: "Patio residencial renovado con pasto sintético" },
  { url: "/cesped-residencial/tres.webp", alt: "Pasto sintético decorativo en un espacio exterior" },
  { url: "/cesped-residencial/cuatro.webp", alt: "Jardín con pasto sintético resistente y de bajo mantenimiento" },
  { url: "/cesped-residencial/cinco.webp", alt: "Transformación de un área residencial con pasto sintético" },
  { url: "/cesped-residencial/seis.webp", alt: "Diseño de jardín minimalista con pasto sintético" },
  { url: "/cesped-residencial/siete.webp", alt: "Pasto sintético instalado en el pasillo lateral de una vivienda" },
];
---

<Layout
  title="Pasto sintético residencial con instalación | Puebla y Los Mochis"
  description="Transforma tu jardín con pasto sintético de bajo mantenimiento. Instalación profesional en Puebla y Los Mochis. Solicita tu cotización."
  ogImageLink="/cesped-residencial/uno.webp"
>
  <a href="#contenido" class="fixed left-4 top-4 z-50 -translate-y-24 rounded-full bg-white px-5 py-3 font-semibold text-deco-blue shadow-xl transition-transform focus:translate-y-0 focus:outline-none focus:ring-4 focus:ring-deco-green/50">
    Ir al contenido
  </a>

  <div class="overflow-x-clip bg-stone-50 font-sfpd text-deco-blue">
    <header class="absolute inset-x-0 top-0 z-20">
      <nav aria-label="Navegación principal" class="mx-auto flex max-w-7xl items-center justify-between px-5 py-6 sm:px-8 lg:px-12">
        <a href="/" aria-label="Decostore, inicio" class="rounded-md focus:outline-none focus:ring-4 focus:ring-deco-green/60">
          <img src="/decostorelogo.svg" alt="Decostore" width="160" height="58" class="h-auto w-32 brightness-0 invert sm:w-36" />
        </a>
        <a href="/" class="hidden min-h-12 items-center gap-2 rounded-full border border-white/30 bg-black/20 px-5 font-semibold text-white backdrop-blur-sm transition hover:bg-white hover:text-deco-blue focus:outline-none focus:ring-4 focus:ring-white/50 md:inline-flex">
          <FontAwesomeIcon icon={faArrowLeft} aria-hidden="true" className="h-4" />
          Volver al inicio
        </a>
        <a href={quoteUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-deco-green px-5 text-sm font-bold text-deco-blue shadow-lg transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-white/60 active:scale-[.98] sm:px-6">
          Cotizar
        </a>
      </nav>
    </header>

    <main id="contenido">
      <section class="relative isolate min-h-[760px] overflow-hidden bg-deco-green-title text-white">
        <img src="/cesped-residencial/uno.webp" alt="Jardín residencial terminado con pasto sintético" width="960" height="1280" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-center lg:left-auto lg:right-0 lg:w-[55%]" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/95 via-black/80 to-black/35 lg:from-deco-green-title lg:via-deco-green-title/95 lg:to-deco-green-title/15"></div>
        <div class="mx-auto flex min-h-[760px] max-w-7xl items-center px-5 pb-16 pt-32 sm:px-8 lg:px-12">
          <div class="max-w-3xl lg:max-w-2xl">
            <nav aria-label="Migas de pan" class="mb-7 flex flex-wrap items-center gap-2 text-sm text-white/70">
              <a href="/" class="rounded hover:text-white focus:outline-none focus:ring-2 focus:ring-deco-green">Inicio</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page" class="text-white">Pasto residencial</span>
            </nav>
            <p class="inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-bold backdrop-blur-sm">Instalación en Puebla y Los Mochis</p>
            <h1 class="mt-5 text-balance font-sigmar text-4xl leading-[1.08] 3sm:text-5xl md:text-6xl">Un jardín verde, listo para disfrutarse.</h1>
            <p class="mt-6 max-w-xl text-pretty text-lg leading-8 text-white/85 md:text-xl">Pasto sintético residencial con apariencia natural, bajo mantenimiento e instalación profesional para patios, terrazas y jardines.</p>
            <div class="mt-9 flex flex-col gap-3 3sm:flex-row">
              <a href={quoteUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-deco-green px-7 font-bold text-deco-blue shadow-xl transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-white/60 active:scale-[.98]">
                Solicitar cotización <FontAwesomeIcon icon={faArrowRight} aria-hidden="true" className="h-4" />
              </a>
              <a href="#opciones" class="inline-flex min-h-14 items-center justify-center rounded-full border border-white/40 bg-white/10 px-7 font-bold text-white backdrop-blur-sm transition hover:bg-white hover:text-deco-blue focus:outline-none focus:ring-4 focus:ring-white/60">Comparar opciones</a>
            </div>
            <div class="mt-10 grid max-w-xl gap-3 text-sm text-white/85 md:grid-cols-3">
              <span class="flex items-center gap-2"><FontAwesomeIcon icon={faCheck} aria-hidden="true" className="h-3 text-deco-green" />Bajo mantenimiento</span>
              <span class="flex items-center gap-2"><FontAwesomeIcon icon={faCheck} aria-hidden="true" className="h-3 text-deco-green" />Uso residencial</span>
              <span class="flex items-center gap-2"><FontAwesomeIcon icon={faCheck} aria-hidden="true" className="h-3 text-deco-green" />Instalación profesional</span>
            </div>
          </div>
        </div>
      </section>

      <section id="opciones" aria-labelledby="options-title" class="px-5 py-20 sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-gray">Dos alturas disponibles</p>
            <h2 id="options-title" class="mt-3 text-balance text-3xl font-bold leading-tight text-deco-green-title sm:text-4xl md:text-5xl">Elige la sensación ideal para tu espacio.</h2>
            <p class="mt-5 text-lg leading-8 text-deco-gray">Compara las dos opciones. Podemos ayudarte a decidir según el uso, el tránsito y el acabado que buscas.</p>
          </div>

          <div class="mt-12 grid gap-6 lg:grid-cols-2">
            <article class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-sm">
              <img src="/25cm.jpg" alt="Detalle del pasto sintético residencial de 25 milímetros" width="642" height="329" loading="lazy" class="aspect-[16/8.2] w-full object-cover" />
              <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div><p class="text-sm font-bold uppercase tracking-[.16em] text-deco-gray">Versátil y práctico</p><h3 class="mt-2 text-3xl font-bold text-deco-green-title">25 mm</h3></div>
                  <span class="rounded-full bg-deco-green/15 px-4 py-2 text-sm font-bold text-deco-green-title">Uso cotidiano</span>
                </div>
                <p class="mt-5 leading-7 text-deco-gray">Una opción equilibrada para patios, pasillos, balcones y jardines con actividad diaria.</p>
                <ul class="mt-8 grid gap-4 3sm:grid-cols-2">
                  {sharedBenefits.map((benefit) => (
                    <li class="flex gap-3 rounded-2xl bg-stone-50 p-4">
                      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-deco-green/15 text-deco-green-title"><FontAwesomeIcon icon={benefit.icon} aria-hidden="true" className="h-4" /></span>
                      <div><h4 class="font-bold text-deco-green-title">{benefit.title}</h4><p class="mt-1 text-sm leading-6 text-deco-gray">{benefit.description}</p></div>
                    </li>
                  ))}
                </ul>
              </div>
            </article>

            <article class="overflow-hidden rounded-[2rem] border border-deco-green/40 bg-deco-green-title text-white shadow-xl">
              <div class="relative">
                <img src="/35cm.jpg" alt="Detalle del pasto sintético residencial de 35 milímetros" width="642" height="329" loading="lazy" class="aspect-[16/8.2] w-full object-cover" />
                <span class="absolute left-5 top-5 rounded-full bg-deco-green px-4 py-2 text-sm font-bold text-deco-green-title shadow-lg">Mayor confort</span>
              </div>
              <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div><p class="text-sm font-bold uppercase tracking-[.16em] text-deco-green">Denso y confortable</p><h3 class="mt-2 text-3xl font-bold">35 mm</h3></div>
                  <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-bold">Acabado premium</span>
                </div>
                <p class="mt-5 leading-7 text-white/75">Mayor densidad y suavidad para jardines, zonas de descanso y espacios familiares.</p>
                <ul class="mt-8 grid gap-4 3sm:grid-cols-2">
                  {premiumBenefits.map((benefit) => (
                    <li class="flex gap-3 rounded-2xl border border-white/10 bg-white/5 p-4">
                      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-deco-green text-deco-green-title"><FontAwesomeIcon icon={benefit.icon} aria-hidden="true" className="h-4" /></span>
                      <div><h4 class="font-bold">{benefit.title}</h4><p class="mt-1 text-sm leading-6 text-white/70">{benefit.description}</p></div>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section aria-labelledby="help-title" class="bg-white px-5 py-20 sm:px-8 lg:px-12">
        <div class="mx-auto grid max-w-7xl overflow-hidden rounded-[2rem] bg-deco-green shadow-xl lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="p-7 sm:p-10 lg:p-12">
            <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-green-title/70">Te ayudamos a elegir</p>
            <h2 id="help-title" class="mt-3 max-w-2xl text-balance text-3xl font-bold leading-tight text-deco-green-title sm:text-4xl">¿25 mm o 35 mm? Depende de cómo vivirás el espacio.</h2>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-deco-green-title/80">Cuéntanos dónde quieres instalarlo y qué uso tendrá. Te recomendaremos la alternativa más conveniente.</p>
          </div>
          <div class="px-7 pb-8 sm:px-10 lg:p-12">
            <a href={quoteUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-14 w-full items-center justify-center gap-3 rounded-full bg-deco-green-title px-7 font-bold text-white transition hover:bg-deco-blue focus:outline-none focus:ring-4 focus:ring-white/70 active:scale-[.98] lg:w-auto">
              Recibir recomendación <FontAwesomeIcon icon={faArrowRight} aria-hidden="true" className="h-4" />
            </a>
          </div>
        </div>
      </section>

      <section id="galery" aria-labelledby="gallery-title" class="px-5 py-20 sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
            <div><p class="text-sm font-bold uppercase tracking-[.18em] text-deco-gray">Proyectos realizados</p><h2 id="gallery-title" class="mt-3 text-balance text-3xl font-bold leading-tight text-deco-green-title sm:text-4xl md:text-5xl">Mira cómo cambia un espacio.</h2></div>
            <p class="max-w-2xl text-lg leading-8 text-deco-gray lg:justify-self-end">Una selección de instalaciones residenciales en jardines, patios y áreas de convivencia.</p>
          </div>
          <div class="mt-12 grid auto-rows-[240px] gap-4 3sm:grid-cols-2 md:auto-rows-[300px] lg:grid-cols-4">
            {gallery.map((image, index) => (
              <figure class:list={["group overflow-hidden rounded-3xl bg-stone-200", { "3sm:row-span-2 lg:col-span-2": index === 0, "lg:col-span-2": index === 5 }]}>
                <img src={image.url} alt={image.alt} width={index === 0 ? 960 : 1200} height={index === 0 ? 1280 : 1600} loading="lazy" class="h-full w-full object-cover transition duration-500 motion-reduce:transition-none group-hover:scale-105 motion-reduce:group-hover:scale-100" />
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section aria-labelledby="cta-title" class="bg-deco-green-title px-5 py-20 text-white sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-green">Hablemos de tu proyecto</p>
          <h2 id="cta-title" class="mt-4 text-balance text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">Dale una nueva vida a tu jardín.</h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75">Escríbenos para conocer opciones, resolver dudas y solicitar una cotización de instalación.</p>
          <a href={quoteUrl} target="_blank" rel="noreferrer" class="mt-8 inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-deco-green px-7 font-bold text-deco-green-title transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-white/60 active:scale-[.98]">
            Cotiza sin compromiso <FontAwesomeIcon icon={faArrowRight} aria-hidden="true" className="h-4" />
          </a>
          <div class="mt-12 border-t border-white/15 pt-8">
            <a href="/" class="inline-flex min-h-12 items-center gap-2 rounded-full px-5 font-semibold text-white/75 transition hover:bg-white/10 hover:text-white focus:outline-none focus:ring-4 focus:ring-deco-green/30"><FontAwesomeIcon icon={faArrowLeft} aria-hidden="true" className="h-4" />Volver al inicio</a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
