---
import Layout from "../layouts/Layout.astro";
import { Header } from "../components/Header";
import { InfoCespedResidencial } from "../components/pages/InfoCespedResidencial";
import { Footer } from "../components/Footer";
import { GaleryCarrusel } from "../components/GaleryCarrusel";
const imagesURL = [
  {
    url: "/cesped-residencial/uno.webp",
    alt: "Instalación de zacate artificial en jardín residencial moderno",
  },
  {
    url: "/cesped-residencial/dos.webp",
    alt: "Patio con zacate artificial",
  },
  {
    url: "/cesped-residencial/tres.webp",
    alt: "Zacate artificial decorativo para espacios exteriores del hogar",
  },
  {
    url: "/cesped-residencial/cuatro.webp",
    alt: "Jardín con pasto sintético resistente y sin mantenimiento",
  },
  {
    url: "/cesped-residencial/cinco.webp",
    alt: "Transformación de área residencial con zacate artificial de alta calidad",
  },
  {
    url: "/cesped-residencial/seis.webp",
    alt: "Diseño de jardín minimalista con zacate artificial",
  },
  {
    url: "/cesped-residencial/siete.webp",
    alt: "Pasto sintético instalado en pasillo lateral de vivienda",
  },
];

const URL =
  "https://wa.me/5212219690933?text=Hola%2C%20me%20gustar%C3%ADa%20cotizar%20una%20instalaci%C3%B3n%20de%20c%C3%A9sped%20sint%C3%A9tico%20residencial.";
---

<Layout
  title="Zacate Artificial con Instalación Profesional | Puebla y Los Mochis"
  description="Transforma tu jardín con zacate artificial sin mantenimiento. Instalación profesional en Puebla y Los Mochis. Solicita tu cotización hoy."
  ogImageLink=""
>
  <Header client:only="react" />
  <InfoCespedResidencial client:only="react" classes="px-5 pt-5" />
  <GaleryCarrusel
    client:only="react"
    classes="pt-10 4sm:pt-20 md:pt-32"
    imagesURL={imagesURL}
  />
  <Footer
    client:only="react"
    href={URL}
    classes={"px-5 py-10 4sm:py-20 md:py-32"}
  />
</Layout>
