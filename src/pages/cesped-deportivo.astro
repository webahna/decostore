---
import ProductServicePage from "../components/ProductServicePage.astro";
import {
  faCalendarDays,
  faCloudSunRain,
  faEye,
  faLeaf,
  faRankingStar,
  faRotate,
  faScrewdriverWrench,
  faShieldHalved,
  faUserShield,
} from "@fortawesome/free-solid-svg-icons";

const benefits = [
  { icon: faShieldHalved, title: "Resistencia al desgaste", description: "Soporta tráfico intenso, clima y uso continuo sin deterioro prematuro." },
  { icon: faCalendarDays, title: "Rendimiento constante", description: "Permite mantener entrenamientos frecuentes y una superficie uniforme." },
  { icon: faScrewdriverWrench, title: "Menor mantenimiento", description: "No requiere riego ni los cuidados continuos del pasto natural." },
  { icon: faUserShield, title: "Mayor seguridad", description: "Una instalación adecuada ofrece una superficie estable para el juego." },
  { icon: faCloudSunRain, title: "Uso en distintos climas", description: "Su drenaje facilita recuperar la cancha después de la lluvia." },
  { icon: faEye, title: "Aspecto profesional", description: "Conserva una apariencia verde, uniforme y atractiva durante todo el año." },
  { icon: faRankingStar, title: "Versatilidad deportiva", description: "Se adapta a diferentes disciplinas, niveles de uso y dimensiones." },
  { icon: faRotate, title: "Disponibilidad continua", description: "No necesita periodos de recuperación como una superficie natural." },
  { icon: faLeaf, title: "Ahorro de recursos", description: "Reduce el consumo de agua y el uso de productos para conservación." },
];
---

<ProductServicePage
  metaTitle="Instalación de pasto sintético deportivo | Decostore"
  description="Instalamos canchas de pasto sintético deportivo de alto rendimiento, con drenaje eficiente y durabilidad para entrenamiento y competencia."
  heroImage="/portada-cesped-deportivo.webp"
  heroAlt="Cancha con pasto sintético deportivo"
  productName="Pasto deportivo"
  eyebrow="Superficies para entrenamiento y competencia"
  title="Una cancha lista para darlo todo."
  lead="Pasto sintético deportivo resistente, uniforme y preparado para acompañar el ritmo de cada entrenamiento."
  highlights={["Alto rendimiento", "Drenaje eficiente", "Uso continuo"]}
  benefitsTitle="Rendimiento constante en cada jugada."
  benefitsLead="Una superficie deportiva debe soportar el uso frecuente, ofrecer estabilidad y conservar una apariencia profesional."
  {benefits}
  applicationsTitle="Una superficie para cada disciplina."
  applicationsLead="Adaptamos la solución a las dimensiones, intensidad de uso y necesidades técnicas del proyecto."
  applications={["Canchas de fútbol y fútbol rápido", "Áreas de entrenamiento y acondicionamiento", "Escuelas, clubes y espacios recreativos", "Proyectos deportivos residenciales o comerciales"]}
  ctaTitle="Construyamos una cancha preparada para jugar."
  ctaLead="Cuéntanos las medidas, el deporte y el uso esperado para recomendarte una solución adecuada."
  quoteUrl="https://wa.me/5212219690933?text=Hola%2C%20me%20gustar%C3%ADa%20cotizar%20una%20instalaci%C3%B3n%20de%20c%C3%A9sped%20sint%C3%A9tico%20deportivo."
/>
