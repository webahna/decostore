---
import Layout from "../layouts/Layout.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import {
  faArrowLeft,
  faArrowRight,
  faCheck,
  faClipboardCheck,
  faLayerGroup,
  faRulerCombined,
} from "@fortawesome/free-solid-svg-icons";

interface Benefit {
  icon: any;
  title: string;
  description: string;
}

type Design = "sport" | "editorial" | "light" | "organic" | "architectural";

interface Props {
  metaTitle: string;
  description: string;
  heroImage: string;
  heroAlt: string;
  productName: string;
  eyebrow: string;
  title: string;
  lead: string;
  highlights: string[];
  benefitsTitle: string;
  benefitsLead: string;
  benefits: Benefit[];
  applicationsTitle: string;
  applicationsLead: string;
  applications: string[];
  ctaTitle: string;
  ctaLead: string;
  quoteUrl: string;
  design: Design;
}

const {
  metaTitle,
  description,
  heroImage,
  heroAlt,
  productName,
  eyebrow,
  title,
  lead,
  highlights,
  benefitsTitle,
  benefitsLead,
  benefits,
  applicationsTitle,
  applicationsLead,
  applications,
  ctaTitle,
  ctaLead,
  quoteUrl,
  design,
} = Astro.props;

const steps = [
  {
    icon: faClipboardCheck,
    number: "01",
    title: "Conocemos tu proyecto",
    description: "Revisamos el espacio, el uso esperado y el resultado que quieres lograr.",
  },
  {
    icon: faRulerCombined,
    number: "02",
    title: "Definimos la solución",
    description: "Te ayudamos a elegir materiales, medidas y acabados adecuados.",
  },
  {
    icon: faLayerGroup,
    number: "03",
    title: "Realizamos la instalación",
    description: "Cuidamos la preparación, la colocación y los detalles finales.",
  },
];

const gallery = [
  { url: "/cesped-residencial/uno.webp", alt: "Instalación residencial de pasto sintético realizada por Decostore" },
  { url: "/cesped-residencial/dos.webp", alt: "Patio renovado con pasto sintético por Decostore" },
  { url: "/cesped-residencial/tres.webp", alt: "Proyecto exterior con pasto sintético de Decostore" },
  { url: "/cesped-residencial/cuatro.webp", alt: "Jardín de bajo mantenimiento instalado por Decostore" },
  { url: "/cesped-residencial/cinco.webp", alt: "Área residencial transformada por Decostore" },
  { url: "/cesped-residencial/seis.webp", alt: "Jardín contemporáneo con pasto sintético" },
];

const styles = {
  sport: {
    page: "bg-zinc-950 text-white",
    hero: "items-end pb-20 lg:pb-24",
    heroCopy: "max-w-4xl border-l-4 border-deco-green pl-5 sm:pl-8",
    heroTitle: "uppercase leading-[.95] md:text-7xl lg:text-8xl",
    eyebrow: "rounded-none border-deco-green bg-deco-green uppercase tracking-[.18em] text-zinc-950",
    benefits: "bg-zinc-950",
    heading: "text-white",
    copy: "text-zinc-300",
    benefitGrid: "md:grid-cols-2 lg:grid-cols-3",
    benefitCard: "rounded-none border-white/15 bg-zinc-900 hover:border-deco-green",
    applicationSection: "bg-deco-green",
    applicationCard: "rounded-none bg-white text-zinc-950 lg:grid-cols-[1.15fr_.85fr]",
    applicationImage: "lg:order-2",
    applicationCopy: "lg:order-1",
    process: "bg-deco-green text-zinc-950",
    processCard: "rounded-none border-2 border-zinc-950 bg-deco-green shadow-[8px_8px_0_0_#18181b]",
    gallery: "bg-zinc-950",
    galleryGrid: "auto-rows-[210px] grid-cols-2 md:auto-rows-[260px] lg:grid-cols-6",
    galleryFrame: "rounded-none border border-white/20",
    cta: "bg-white text-zinc-950",
    ctaButton: "rounded-none bg-zinc-950 text-white hover:bg-deco-green hover:text-zinc-950",
  },
  editorial: {
    page: "bg-[#f2ece2] text-[#302920]",
    hero: "items-center",
    heroCopy: "max-w-2xl",
    heroTitle: "leading-[1.08] md:text-7xl",
    eyebrow: "rounded-full border-[#d8c5a9]/60 bg-[#d8c5a9]/15 tracking-[.14em] text-[#f2e5d2]",
    benefits: "bg-[#f2ece2]",
    heading: "text-[#302920]",
    copy: "text-[#6f6254]",
    benefitGrid: "md:grid-cols-2",
    benefitCard: "rounded-none border-x-0 border-b-0 border-t-[#b9a990] bg-transparent shadow-none hover:border-[#6f6254] hover:shadow-none",
    applicationSection: "bg-[#e5d6c2]",
    applicationCard: "rounded-t-[7rem] rounded-b-none bg-[#3d3329] text-white lg:grid-cols-[.9fr_1.1fr]",
    applicationImage: "",
    applicationCopy: "",
    process: "bg-[#e5d6c2] text-[#302920]",
    processCard: "rounded-t-[5rem] rounded-b-none border-[#ad987c] bg-[#f2ece2] px-7 pb-8 pt-16",
    gallery: "bg-[#f2ece2]",
    galleryGrid: "auto-rows-[230px] grid-cols-2 md:auto-rows-[310px] lg:grid-cols-4",
    galleryFrame: "rounded-t-[4rem] rounded-b-none",
    cta: "bg-[#3d3329] text-white",
    ctaButton: "rounded-full bg-[#e0c49d] text-[#302920] hover:bg-white",
  },
  light: {
    page: "bg-slate-50 text-slate-900",
    hero: "items-center",
    heroCopy: "max-w-2xl rounded-[2.5rem] bg-white/90 p-7 text-slate-900 shadow-2xl backdrop-blur sm:p-10",
    heroTitle: "font-sfpd font-light leading-[1.05] tracking-tight md:text-7xl",
    eyebrow: "rounded-full border-slate-300 bg-white text-slate-700",
    benefits: "bg-white",
    heading: "text-slate-900",
    copy: "text-slate-600",
    benefitGrid: "sm:grid-cols-2 lg:grid-cols-3",
    benefitCard: "rounded-[2rem] border-slate-200 bg-slate-50 hover:bg-white",
    applicationSection: "bg-slate-50",
    applicationCard: "rounded-[3rem] border border-slate-200 bg-white text-slate-900 lg:grid-cols-2",
    applicationImage: "lg:m-4 lg:overflow-hidden lg:rounded-[2.25rem]",
    applicationCopy: "",
    process: "bg-white text-slate-900",
    processCard: "rounded-[2rem] border-slate-200 bg-slate-50 shadow-none",
    gallery: "bg-slate-100",
    galleryGrid: "auto-rows-[220px] grid-cols-2 md:auto-rows-[280px] lg:grid-cols-3",
    galleryFrame: "rounded-[2rem]",
    cta: "bg-white text-slate-900",
    ctaButton: "rounded-full bg-slate-900 text-white hover:bg-deco-green hover:text-slate-950",
  },
  organic: {
    page: "bg-[#edf5e8] text-[#17351f]",
    hero: "items-end justify-center pb-20 text-center",
    heroCopy: "mx-auto max-w-3xl",
    heroTitle: "leading-[1.08] md:text-7xl",
    eyebrow: "rounded-full border-white/30 bg-white/10 text-white",
    benefits: "bg-[#edf5e8]",
    heading: "text-[#17351f]",
    copy: "text-[#53705a]",
    benefitGrid: "3sm:grid-cols-2 lg:grid-cols-3",
    benefitCard: "rounded-[3rem_1rem_3rem_1rem] border-[#bfd0b9] bg-white/60 hover:bg-white",
    applicationSection: "bg-[#dcebd5]",
    applicationCard: "rounded-[4rem_1rem_4rem_1rem] bg-[#17351f] text-white lg:grid-cols-[1.05fr_.95fr]",
    applicationImage: "",
    applicationCopy: "",
    process: "bg-[#edf5e8] text-[#17351f]",
    processCard: "rounded-[1rem_3rem_1rem_3rem] border-[#aec5a7] bg-[#dcebd5] shadow-none",
    gallery: "bg-[#dcebd5]",
    galleryGrid: "auto-rows-[230px] grid-cols-2 md:auto-rows-[290px] lg:grid-cols-4",
    galleryFrame: "rounded-[3rem_1rem_3rem_1rem]",
    cta: "bg-[#17351f] text-white",
    ctaButton: "rounded-full bg-[#c8df87] text-[#17351f] hover:bg-white",
  },
  architectural: {
    page: "bg-[#f0e8dc] text-[#2b2723]",
    hero: "items-center",
    heroCopy: "max-w-3xl border border-white/30 bg-[#2b2723]/65 p-6 backdrop-blur-sm sm:p-10",
    heroTitle: "font-sfpd font-bold leading-[1.02] tracking-tight md:text-7xl",
    eyebrow: "rounded-none border-y-0 border-r-0 border-l-4 border-[#d29a5a] bg-transparent uppercase tracking-[.2em] text-[#efd8bd]",
    benefits: "bg-[#f0e8dc]",
    heading: "text-[#2b2723]",
    copy: "text-[#6f6257]",
    benefitGrid: "md:grid-cols-3",
    benefitCard: "rounded-none border-[#cdbba7] bg-[#f8f3eb]",
    applicationSection: "bg-[#f8f3eb]",
    applicationCard: "rounded-none border border-[#bba48b] bg-[#f0e8dc] text-[#2b2723] lg:grid-cols-[1.2fr_.8fr]",
    applicationImage: "lg:order-2",
    applicationCopy: "lg:order-1",
    process: "bg-[#2b2723] text-white",
    processCard: "rounded-none border-x-0 border-y-0 border-l-4 border-[#d29a5a] bg-white/5 shadow-none",
    gallery: "bg-[#f0e8dc]",
    galleryGrid: "auto-rows-[210px] grid-cols-2 md:auto-rows-[280px] lg:grid-cols-6",
    galleryFrame: "rounded-none border border-[#cdbba7]",
    cta: "bg-[#d29a5a] text-[#2b2723]",
    ctaButton: "rounded-none bg-[#2b2723] text-white hover:bg-white hover:text-[#2b2723]",
  },
} as const;

const style = styles[design];

const gallerySpan = (index: number) => {
  if (design === "sport") return index === 0 ? "col-span-2 row-span-2 lg:col-span-3" : index === 5 ? "col-span-2 lg:col-span-2" : "lg:col-span-1";
  if (design === "editorial" || design === "organic") return index === 0 ? "col-span-2 row-span-2" : index === 3 ? "col-span-2" : "";
  if (design === "light") return index === 1 || index === 4 ? "row-span-2" : "";
  return index === 0 ? "col-span-2 lg:col-span-3 lg:row-span-2" : index === 5 ? "col-span-2 lg:col-span-3" : "lg:col-span-1";
};
---

<Layout title={metaTitle} description={description} ogImageLink={heroImage}>
  <a href="#contenido" class="fixed left-4 top-4 z-50 -translate-y-24 rounded-full bg-white px-5 py-3 font-semibold text-deco-blue shadow-xl transition-transform focus:translate-y-0 focus:outline-none focus:ring-4 focus:ring-deco-green/50">
    Ir al contenido
  </a>

  <div class="overflow-x-clip bg-stone-50 font-sfpd text-deco-blue">
    <header class="absolute inset-x-0 top-0 z-20">
      <nav aria-label="Navegación principal" class="mx-auto flex max-w-7xl items-center justify-between px-5 py-6 sm:px-8 lg:px-12">
        <a href="/" aria-label="Decostore, inicio" class="rounded-md focus:outline-none focus:ring-4 focus:ring-deco-green/60">
          <img src="/decostorelogo.svg" alt="Decostore" width="160" height="58" class="h-auto w-32 brightness-0 invert sm:w-36" />
        </a>
        <a href="/" class="hidden min-h-12 items-center gap-2 rounded-full border border-white/30 bg-black/20 px-5 font-semibold text-white backdrop-blur-sm transition hover:bg-white hover:text-deco-blue focus:outline-none focus:ring-4 focus:ring-white/50 md:inline-flex">
          <FontAwesomeIcon icon={faArrowLeft} aria-hidden="true" className="h-4" />
          Volver al inicio
        </a>
        <a href={quoteUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-deco-green px-5 text-sm font-bold text-deco-blue shadow-lg transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-white/60 active:scale-[.98] sm:px-6">
          Cotizar
        </a>
      </nav>
    </header>

    <main id="contenido">
      <section class="relative isolate min-h-[760px] overflow-hidden bg-deco-green-title text-white">
        <img src={heroImage} alt={heroAlt} width="1024" height="512" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/90 via-black/70 to-black/25 lg:from-deco-green-title lg:via-deco-green-title/90 lg:to-transparent"></div>
        <div class="mx-auto flex min-h-[760px] max-w-7xl items-center px-5 pb-16 pt-32 sm:px-8 lg:px-12">
          <div class="max-w-3xl lg:max-w-2xl">
            <nav aria-label="Migas de pan" class="mb-7 flex flex-wrap items-center gap-2 text-sm text-white/70">
              <a href="/" class="rounded hover:text-white focus:outline-none focus:ring-2 focus:ring-deco-green">Inicio</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page" class="text-white">{productName}</span>
            </nav>
            <p class="inline-flex rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-bold backdrop-blur-sm">{eyebrow}</p>
            <h1 class="mt-5 text-balance font-sigmar text-4xl leading-[1.08] 3sm:text-5xl md:text-6xl">{title}</h1>
            <p class="mt-6 max-w-xl text-pretty text-lg leading-8 text-white/85 md:text-xl">{lead}</p>
            <div class="mt-9 flex flex-col gap-3 3sm:flex-row">
              <a href={quoteUrl} target="_blank" rel="noreferrer" class="inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-deco-green px-7 font-bold text-deco-blue shadow-xl transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-white/60 active:scale-[.98]">
                Solicitar cotización <FontAwesomeIcon icon={faArrowRight} aria-hidden="true" className="h-4" />
              </a>
              <a href="#beneficios" class="inline-flex min-h-14 items-center justify-center rounded-full border border-white/40 bg-white/10 px-7 font-bold text-white backdrop-blur-sm transition hover:bg-white hover:text-deco-blue focus:outline-none focus:ring-4 focus:ring-white/60">Ver beneficios</a>
            </div>
            <div class="mt-10 grid max-w-2xl gap-3 text-sm text-white/85 md:grid-cols-3">
              {highlights.map((highlight) => (
                <span class="flex items-center gap-2"><FontAwesomeIcon icon={faCheck} aria-hidden="true" className="h-3 text-deco-green" />{highlight}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="beneficios" aria-labelledby="benefits-title" class="px-5 py-20 sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
            <div>
              <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-gray">Por qué elegirlo</p>
              <h2 id="benefits-title" class="mt-3 max-w-2xl text-balance text-3xl font-bold leading-tight text-deco-green-title sm:text-4xl md:text-5xl">{benefitsTitle}</h2>
            </div>
            <p class="max-w-2xl text-lg leading-8 text-deco-gray lg:justify-self-end">{benefitsLead}</p>
          </div>
          <ul class="mt-12 grid gap-4 3sm:grid-cols-2 lg:grid-cols-3">
            {benefits.map((benefit, index) => (
              <li class="group rounded-3xl border border-stone-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-deco-green/50 hover:shadow-xl md:p-7">
                <div class="flex items-center justify-between">
                  <span class="grid size-12 place-items-center rounded-2xl bg-deco-green/15 text-deco-green-title"><FontAwesomeIcon icon={benefit.icon} aria-hidden="true" className="h-5" /></span>
                  <span class="text-sm font-bold tabular-nums text-stone-400">{String(index + 1).padStart(2, "0")}</span>
                </div>
                <h3 class="mt-7 text-xl font-bold text-deco-green-title">{benefit.title}</h3>
                <p class="mt-2 leading-7 text-deco-gray">{benefit.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section aria-labelledby="applications-title" class="bg-white px-5 py-20 sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto grid max-w-7xl overflow-hidden rounded-[2rem] bg-deco-green-title text-white shadow-2xl lg:grid-cols-2">
          <div class="relative min-h-80 lg:min-h-[560px]">
            <img src={heroImage} alt="" width="1024" height="512" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          </div>
          <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-14">
            <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-green">Dónde funciona mejor</p>
            <h2 id="applications-title" class="mt-4 text-balance text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">{applicationsTitle}</h2>
            <p class="mt-5 text-lg leading-8 text-white/75">{applicationsLead}</p>
            <ul class="mt-8 space-y-4">
              {applications.map((application) => (
                <li class="flex items-start gap-3 text-white/90">
                  <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-deco-green text-deco-green-title"><FontAwesomeIcon icon={faCheck} aria-hidden="true" className="h-3" /></span>
                  <span>{application}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section aria-labelledby="process-title" class="px-5 py-20 sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-7xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-gray">Un proceso claro</p>
            <h2 id="process-title" class="mt-3 text-balance text-3xl font-bold leading-tight text-deco-green-title sm:text-4xl md:text-5xl">De la idea a un espacio terminado.</h2>
          </div>
          <ol class="mt-12 grid gap-5 md:grid-cols-3">
            {steps.map((step) => (
              <li class="rounded-3xl border border-stone-200 bg-white p-7 shadow-sm">
                <div class="flex items-center justify-between">
                  <span class="grid size-12 place-items-center rounded-2xl bg-deco-green text-deco-green-title"><FontAwesomeIcon icon={step.icon} aria-hidden="true" className="h-5" /></span>
                  <span class="font-bold text-stone-400">{step.number}</span>
                </div>
                <h3 class="mt-7 text-xl font-bold text-deco-green-title">{step.title}</h3>
                <p class="mt-2 leading-7 text-deco-gray">{step.description}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section aria-labelledby="cta-title" class="bg-deco-green-title px-5 py-20 text-white sm:px-8 md:py-28 lg:px-12">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-sm font-bold uppercase tracking-[.18em] text-deco-green">Hablemos de tu proyecto</p>
          <h2 id="cta-title" class="mt-4 text-balance text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">{ctaTitle}</h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75">{ctaLead}</p>
          <a href={quoteUrl} target="_blank" rel="noreferrer" class="mt-8 inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-deco-green px-7 font-bold text-deco-green-title transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-white/60 active:scale-[.98]">
            Cotiza sin compromiso <FontAwesomeIcon icon={faArrowRight} aria-hidden="true" className="h-4" />
          </a>
          <div class="mt-12 border-t border-white/15 pt-8">
            <a href="/" class="inline-flex min-h-12 items-center gap-2 rounded-full px-5 font-semibold text-white/75 transition hover:bg-white/10 hover:text-white focus:outline-none focus:ring-4 focus:ring-deco-green/30"><FontAwesomeIcon icon={faArrowLeft} aria-hidden="true" className="h-4" />Volver al inicio</a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
